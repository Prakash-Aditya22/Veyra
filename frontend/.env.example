# Copy to .env.local (gitignored) to change the data source or basemap.

# 'local' (default): the verified demo bundle in public/data/demo-v2, no backend needed.
# 'api': the Spring Boot backend. Not connected yet: see BACKEND_INTEGRATION.md.
VITE_DATA_MODE=local

# Required when VITE_DATA_MODE=api, e.g. http://localhost:8080/api
VITE_API_BASE_URL=

# Where the local bundle is served (default: <base>/data/demo-v2)
# VITE_LOCAL_DATA_URL=/data/demo-v2

# ---- Map tiles (independent of the data source; see README "Map provider configuration") ----
# Unset: OpenStreetMap standard tiles, darkened with CSS (demo only; light use under OSM policy).
# 'none': no basemap (neutral background and a notice).
# For production use an approved provider or self-hosted tiles. Never commit a real key.
# CARTO (your own key, free for non-commercial use): see README "Map provider configuration".
# VITE_BASEMAP_URL=https://tiles.example.com/dark/{z}/{x}/{y}.png?key=YOUR_KEY
# VITE_BASEMAP_ATTRIBUTION=&copy; OpenStreetMap contributors &copy; Example provider
# VITE_BASEMAP_FILTER=auto            # auto | on (darken a light style) | off (dark style)
# VITE_BASEMAP_MAX_ZOOM=19
# VITE_BASEMAP_SUBDOMAINS=abc
# VITE_BASEMAP_LABEL=Example provider
# VITE_BASEMAP_CORS=true              # provider sends CORS headers: lets the map recognise a blocked-tile image
